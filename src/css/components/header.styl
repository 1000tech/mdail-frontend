#header
    position fixed
    z-index 1
    width 120px
    height 100%
    padding 30px 0 0 10px
    //background linear-gradient(to bottom, cyan, $purple)
    background blue
    transition box-shadow .25s
    box-shadow: 0 0 1px $sky-blue, 0 0 2px $sky-blue, 0 0 5px $sky-blue, 0 0 5px $sky-blue, 0 0 10px $sky-blue, 0 0 20px $sky-blue, 0 0 25px $sky-blue