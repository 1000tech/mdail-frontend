body
    margin auto
    font 18px 'R', sans-serif
    height 100%

main
    position relative
    min-height 100%
    padding 0 0 env(safe-area-inset-bottom)
    display grid
    justify-content flex-start
    grid-template-columns 100px 1fr
    grid-template-rows 1fr auto
    grid-template-areas "header aricle";

::selection
    background $purple
    color #fff

.Windows, .Linux
    $scroll-width = 8px
    body
        overflow-y scroll
    ::-webkit-scrollbar // Основная ширина полосы прокрутки
        background #fff
        width $scroll-width
    ::-webkit-scrollbar-thumb // Бегунок
        background #ccc
        width $scroll-width
        border-radius 20px
    &.night
        ::-webkit-scrollbar // Основная ширина полосы прокрутки
            background #232323
        ::-webkit-scrollbar-thumb // Бегунок
            background #888