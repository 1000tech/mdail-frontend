body
    margin auto
    background $grey-color
    font 18px 'R', sans-serif
    max-width $xl
    height 100%

main
    position relative
    background #fff
    transition background .3s
    max-width $xl
    min-height 100%
    margin auto
    padding 0 0 env(safe-area-inset-bottom)

::selection
    background $purple
    color #fff

.Windows, .Linux
    $scroll-width = 8px
    body
        overflow-y scroll
    ::-webkit-scrollbar // Основная ширина полосы прокрутки
        background #fff
        width $scroll-width
    ::-webkit-scrollbar-thumb // Бегунок
        background #ccc
        width $scroll-width
        border-radius 20px
    &.night
        ::-webkit-scrollbar // Основная ширина полосы прокрутки
            background #232323
        ::-webkit-scrollbar-thumb // Бегунок
            background #888

.progress
    position absolute
    top $header-height
    left 0
    z-index 4
    height 5px
    max-width 100%
    background $gradient

figure
    text-align center

figcaption
    background $gradient
    font 600 16px/32px 'R'
    display inline-block
    border-radius 20px
    margin 10px 0 0
    padding 0 20px
    color #fff