body
    margin auto
    font 18px 'R', sans-serif
    height 100%
    color #222
    --blue-color $blue
    --grey-color $grey
    background var(--grey-color)

::selection
    background $blue
    color #fff

// Scroll
.Windows, .Linux
    $scroll-width = 8px
    body
        overflow-y scroll
    ::-webkit-scrollbar // Основная ширина полосы прокрутки
        background #fff
        width $scroll-width
    ::-webkit-scrollbar-thumb // Бегунок
        background #ccc
        width $scroll-width
        border-radius 20px
    &.night
        ::-webkit-scrollbar // Основная ширина полосы прокрутки
            background #232323
        ::-webkit-scrollbar-thumb // Бегунок
            background #888

// Modal
.modal-enter-active, .modal-leave-active
    transition opacity $time
.modal-enter, .modal-leave-to
    opacity 0
    transition opacity $time
.modal
    extend()
    position fixed
    display flex
    align-items center
    justify-content center
.modal-backdrop
    extend()
    z-index 2
    background $shadow
    backdrop-filter blur(4px)
.modal-content
    position relative
    z-index 3
    background #fff
    box-shadow 0 2px 16px 0 $shadow
    padding 32px
    overflow-x auto
    display flex
    flex-direction column