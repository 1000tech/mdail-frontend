body
    margin auto
    font 18px 'R', sans-serif
    height 100%
    color #222
    background var(--grey-color)
    --blue-color $blue
    --grey-color $grey

::selection
    background $blue
    color #fff

// Scroll
.Windows, .Linux
    $scroll-width = 8px
    body
        overflow-y scroll
    ::-webkit-scrollbar // Основная ширина полосы прокрутки
        background #fff
        width $scroll-width
    ::-webkit-scrollbar-thumb // Бегунок
        background linear-gradient(to bottom, #6d31f4, #302bdc)
        width $scroll-width
        border-radius 20px
    &.night
        ::-webkit-scrollbar // Основная ширина полосы прокрутки
            background #000