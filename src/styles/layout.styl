body
    margin auto
    font 18px 'R', sans-serif
    height 100%
    color #222
    background var(--grey-color)
    --blue-color $blue
    --grey-color $grey

::selection
    background $blue
    color $white

::placeholder
    color $input-grey

h1, h2
    display flex
    align-content center

h1
    font 600 34px/40px 'R'

h2
    font 600 30px/36px 'R'

// Scroll
.Windows, .Linux
    $scroll-width = 8px
    body
        overflow-y scroll
    ::-webkit-scrollbar // Основная ширина полосы прокрутки
        background $white
        width $scroll-width
    ::-webkit-scrollbar-thumb // Бегунок
        background linear-gradient(to bottom, #6d31f4, #302bdc)
        width $scroll-width
        border-radius 20px
    &.night
        ::-webkit-scrollbar // Основная ширина полосы прокрутки
            background #000